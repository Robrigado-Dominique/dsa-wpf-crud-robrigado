<Window x:Class="crud_robrigado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:crud_robrigado"
        mc:Ignorable="d"
        Title="MainWindow" Height="446" Width="798"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <DataGrid x:Name="itemz" ItemsSource="{Binding Item}" AutoGenerateColumns="False"  Margin="29,57,29,235" BorderBrush="#FFABB6C1" FontWeight="Bold" Background="#FFFFEBEB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description }" Width="220"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock HorizontalAlignment="Center" Margin="0,11,0,0" TextWrapping="Wrap" Text="Shopping Cart System" VerticalAlignment="Top" FontFamily="Bahnschrift SemiBold" FontWeight="Bold" FontSize="18"/>
        <Rectangle HorizontalAlignment="Center" Height="55" Margin="0,365,0,0" Stroke="#FFA5A1A1" VerticalAlignment="Top" Width="742" RenderTransformOrigin="0.5,0.5" Fill="#FFFFF2F2">
        </Rectangle>
        <TextBox Name="IdItem" HorizontalAlignment="Left" Margin="53,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="39" />
        <TextBox Name="NameItem" HorizontalAlignment="Left" Margin="106,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88" />
        <TextBox Name="DescItem" HorizontalAlignment="Left" Margin="210,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="125"/>
        <TextBox Name="PriceItem" HorizontalAlignment="Left" Margin="350,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88" />

        <DataGrid x:Name="dataGrid" ItemsSource="{Binding dataGrid}" Margin="29,218,29,80" FontWeight="Bold" Background="#FFFFEDED" SelectionChanged="dataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="220"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock HorizontalAlignment="Center" Margin="0,11,0,0" TextWrapping="Wrap" Text="Shopping Cart System" VerticalAlignment="Top" FontFamily="Bahnschrift SemiBold" FontWeight="Bold" FontSize="18"/>
        <TextBox Name="IdAdd" HorizontalAlignment="Left" Margin="53,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="39" />
        <TextBox Name="NameAdd" HorizontalAlignment="Left" Margin="106,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88" />
        <TextBox Name="DescAdd" HorizontalAlignment="Left" Margin="210,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="125"/>
        <TextBox Name="PriceAdd" HorizontalAlignment="Left" Margin="350,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88" />

        <TextBlock HorizontalAlignment="Center" Margin="0,201,0,0" TextWrapping="Wrap" Text="Shopping Cart" VerticalAlignment="Top" FontSize="11" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,39,0,0" TextWrapping="Wrap" Text="Available Items" VerticalAlignment="Top" FontWeight="Bold" FontSize="11"/>

        <Button Content="Add Item" HorizontalAlignment="Left" Margin="537,391,0,0" VerticalAlignment="Top" Width="55" RenderTransformOrigin="0.5,0.5" FontSize="10" Click="AddItem_Click">
        </Button>
        <TextBox HorizontalAlignment="Left" Margin="52,374,0,0" TextWrapping="Wrap" Text="ID" VerticalAlignment="Top" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <TextBox HorizontalAlignment="Left" Margin="103,375,0,0" TextWrapping="Wrap" Text="Name" VerticalAlignment="Top" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <TextBox HorizontalAlignment="Left" Margin="207,375,0,0" TextWrapping="Wrap" Text="Description" VerticalAlignment="Top" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <TextBox HorizontalAlignment="Left" Margin="350,376,0,40" TextWrapping="Wrap" Text="Price" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <Button Content="Remove Item" HorizontalAlignment="Left" Margin="606,391,0,0" VerticalAlignment="Top" Width="68" RenderTransformOrigin="0.5,0.5" FontSize="10" Click="Remove_Click">
        </Button>
        <Button Content="Add to Cart" HorizontalAlignment="Left" Margin="688,391,0,0" VerticalAlignment="Top" Width="59" RenderTransformOrigin="0.5,0.5" FontSize="10" Click="AddCart_Click" Command="{Binding BindsDirectlyToSource=True, ElementName=dataGrid, Mode=OneWay}">
        </Button>
        <Button Content="Clear" HorizontalAlignment="Left" Margin="478,391,0,0" VerticalAlignment="Top" Width="45" RenderTransformOrigin="0.5,0.5" FontSize="10" Click="Clear_Click">
        </Button>


    </Grid>
</Window>
