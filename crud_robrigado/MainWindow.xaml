<Window x:Class="crud_robrigado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:crud_robrigado"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="446"
        Width="798"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- Available Items -->
        <TextBlock HorizontalAlignment="Center"
                   Margin="0,11,0,0"
                   Text="Shopping Cart System"
                   VerticalAlignment="Top"
                   FontFamily="Bahnschrift SemiBold"
                   FontWeight="Bold"
                   FontSize="18"/>

        <TextBlock HorizontalAlignment="Center"
                   Margin="0,39,0,0"
                   Text="Available Items"
                   VerticalAlignment="Top"
                   FontWeight="Bold"
                   FontSize="11"/>

        <DataGrid x:Name="itemz"
                  ItemsSource="{Binding Item}"
                  AutoGenerateColumns="False"
                  Margin="29,57,29,235"
                  BorderBrush="#FFABB6C1"
                  FontWeight="Bold"
                  Background="#FFFFEBEB">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="70"/>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="120"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="220"/>

                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price}"
                                    Width="120"/>
            </DataGrid.Columns>

        </DataGrid>

        <!-- Shopping Cart -->
        <TextBlock HorizontalAlignment="Center"
                   Margin="0,201,0,0"
                   Text="Shopping Cart"
                   VerticalAlignment="Top"
                   FontSize="11"
                   FontWeight="Bold"/>

        <DataGrid x:Name="cartzz"
                  ItemsSource="{Binding cartz}"
                  AutoGenerateColumns="False"
                  Margin="29,218,29,80"
                  FontWeight="Bold"
                  Background="#FFFFEDED">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="70"/>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="120"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="220"/>

                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price}"
                                    Width="120"/>
            </DataGrid.Columns>

        </DataGrid>

        <!-- Bottom Panel -->
        <Rectangle HorizontalAlignment="Center"
                   Height="55"
                   Margin="0,365,0,0"
                   Stroke="#FFA5A1A1"
                   VerticalAlignment="Top"
                   Width="742"
                   Fill="#FFFFF2F2"/>

        <!-- Labels -->
        <TextBox HorizontalAlignment="Left"
                 Margin="43,374,0,0"
                 Text="ID"
                 VerticalAlignment="Top"
                 Width="80"
                 BorderBrush="{x:Null}"
                 FontFamily="Segoe UI Variable Display Semibold"
                 FontSize="10"
                 Background="{x:Null}"/>

        <TextBox HorizontalAlignment="Left"
                 Margin="95,375,0,0"
                 Text="Name"
                 VerticalAlignment="Top"
                 Width="80"
                 BorderBrush="{x:Null}"
                 FontFamily="Segoe UI Variable Display Semibold"
                 FontSize="10"
                 Background="{x:Null}"/>

        <TextBox HorizontalAlignment="Left"
                 Margin="198,375,0,0"
                 Text="Description"
                 VerticalAlignment="Top"
                 Width="80"
                 BorderBrush="{x:Null}"
                 FontFamily="Segoe UI Variable Display Semibold"
                 FontSize="10"
                 Background="{x:Null}"/>

        <TextBox HorizontalAlignment="Left"
                 Margin="302,376,0,40"
                 Text="Price"
                 Width="80"
                 BorderBrush="{x:Null}"
                 FontFamily="Segoe UI Variable Display Semibold"
                 FontSize="10"
                 Background="{x:Null}"/>

        <!-- Input Textboxes -->
        <TextBox Name="IdAdd"
                 HorizontalAlignment="Left"
                 Margin="44,391,0,0"
                 VerticalAlignment="Top"
                 Width="39"/>

        <TextBox Name="NameAdd"
                 HorizontalAlignment="Left"
                 Margin="98,391,0,0"
                 VerticalAlignment="Top"
                 Width="88"/>

        <TextBox Name="DescAdd"
                 HorizontalAlignment="Left"
                 Margin="200,391,0,0"
                 VerticalAlignment="Top"
                 Width="89"/>

        <TextBox Name="PriceAdd"
                 HorizontalAlignment="Left"
                 Margin="304,391,0,0"
                 VerticalAlignment="Top"
                 Width="66"/>

        <!-- Buttons -->
        <Button Content="Clear"
                HorizontalAlignment="Left"
                Margin="383,391,0,0"
                VerticalAlignment="Top"
                Width="45"
                FontSize="10"
                Click="Clear_Click"/>

        <Button Content="Add Item"
                HorizontalAlignment="Left"
                Margin="436,391,0,0"
                VerticalAlignment="Top"
                Width="55"
                FontSize="10"
                Click="AddItem_Click"/>

        <Button Content="Remove Product"
                HorizontalAlignment="Left"
                Margin="499,391,0,0"
                VerticalAlignment="Top"
                Width="77"
                FontSize="10"
                Click="Remove_Click"/>

        <Button Content="Add to Cart"
                HorizontalAlignment="Left"
                Margin="584,391,0,0"
                VerticalAlignment="Top"
                Width="59"
                FontSize="10"
                Click="AddCart_Click"/>
        <Button Content="Remove from the Cart"
        HorizontalAlignment="Left"
        Margin="651,391,0,0"
        VerticalAlignment="Top"
        Width="107"
        Height="18"
        FontSize="10"
        Click="RemoveCart_Click"/>

    </Grid>
</Window>