<Window x:Class="crud_robrigado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:crud_robrigado"
        mc:Ignorable="d"
        Title="MainWindow" Height="446" Width="798"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <DataGrid x:Name="employeez" ItemsSource="{Binding Employee}" AutoGenerateColumns="False"  Margin="29,70,29,76" BorderBrush="#FFABB6C1" FontWeight="Bold" Background="#FFFFEBEB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="120"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="*"/>
                <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock HorizontalAlignment="Center" Margin="0,34,0,0" TextWrapping="Wrap" Text="Employees" VerticalAlignment="Top" FontFamily="Magneto" FontWeight="Bold" FontSize="20"/>
        <Rectangle HorizontalAlignment="Center" Height="55" Margin="0,365,0,0" Stroke="#FFA5A1A1" VerticalAlignment="Top" Width="742" RenderTransformOrigin="0.5,0.5" Fill="#FFFFF2F2">
        </Rectangle>
        <TextBox Name="IdUser" HorizontalAlignment="Left" Margin="38,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="39" />
        <TextBox Name="NameUser" HorizontalAlignment="Left" Margin="90,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="84" />
        <TextBox Name="TitleUser" HorizontalAlignment="Left" Margin="190,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="78"/>
        <TextBox Name="DeptUser" HorizontalAlignment="Left" Margin="283,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="99" />
        <TextBox Name="SalaryUser" HorizontalAlignment="Left" Margin="397,391,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88" />

        <Button Content="Add" HorizontalAlignment="Left" Margin="502,391,0,0" VerticalAlignment="Top" Width="54" RenderTransformOrigin="0.5,0.5" FontSize="10" Click="Add_Click">
        </Button>
        <TextBox HorizontalAlignment="Left" Margin="37,374,0,0" TextWrapping="Wrap" Text="ID" VerticalAlignment="Top" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <TextBox HorizontalAlignment="Left" Margin="89,375,0,0" TextWrapping="Wrap" Text="Name" VerticalAlignment="Top" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <TextBox HorizontalAlignment="Left" Margin="188,375,0,0" TextWrapping="Wrap" Text="Title" VerticalAlignment="Top" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <TextBox HorizontalAlignment="Left" Margin="281,374,0,0" TextWrapping="Wrap" Text="Department" VerticalAlignment="Top" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <TextBox HorizontalAlignment="Left" Margin="396,375,0,41" TextWrapping="Wrap" Text="Salary" Width="80" BorderBrush="{x:Null}" FontFamily="Segoe UI Variable Display Semibold" FontSize="10" Background="{x:Null}"/>
        <Button Content="Remove" HorizontalAlignment="Left" Margin="567,391,0,0" VerticalAlignment="Top" Width="61" RenderTransformOrigin="0.5,0.5" FontSize="10" Click="Remove_Click">
        </Button>
        <Button Content="Update" HorizontalAlignment="Left" Margin="640,391,0,0" VerticalAlignment="Top" Width="59" RenderTransformOrigin="0.5,0.5" FontSize="10" Click="Update_Click">
        </Button>
        <Button Content="Clear" HorizontalAlignment="Left" Margin="709,391,0,0" VerticalAlignment="Top" Width="54" RenderTransformOrigin="0.5,0.5" FontSize="10" Click="Clear_Click">
        </Button>

    </Grid>
</Window>